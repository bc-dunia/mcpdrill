{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpdrill.local/schemas/op-log/v1.json",
  "title": "OperationLogLine (op-log/v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "timestamp",
    "tier",
    "run_id",
    "execution_id",
    "stage",
    "stage_id",
    "worker_id",
    "vu_id",
    "session_id",
    "operation",
    "latency_ms",
    "ok"
  ],
  "properties": {
    "version": {"type": "string", "const": "op-log/v1"},
    "timestamp": {"type": "string", "format": "date-time"},
    "tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "run_id": {"type": "string", "maxLength": 128},
    "execution_id": {"type": "string", "maxLength": 128},
    "stage": {"type": "string", "maxLength": 128},
    "stage_id": {"type": "string", "maxLength": 128},
    "worker_id": {"type": "string", "maxLength": 128},
    "vu_id": {"type": "string", "maxLength": 256},
    "session_id": {"type": "string", "maxLength": 256},
    "op_id": {"type": "string", "maxLength": 128},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1000},
    "operation": {"type": "string", "enum": ["initialize", "notifications/initialized", "server/discover", "tools_list", "tools_call", "resources_list", "resources_read", "prompts_list", "prompts_get", "subscriptions_listen", "tasks_get", "tasks_update", "tasks_cancel", "ping", "custom", "tools/list", "tools/call", "resources/list", "resources/read", "prompts/list", "prompts/get", "subscriptions/listen", "tasks/get", "tasks/update", "tasks/cancel"]},
    "tool_name": {"type": "string", "maxLength": 200},
    "latency_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
    "first_byte_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
    "phase_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns_ms", "tcp_connect_ms", "ttfb_ms", "download_ms", "e2e_ms", "connection_reused"],
      "properties": {
        "dns_ms": {"type": "integer", "minimum": 0},
        "tcp_connect_ms": {"type": "integer", "minimum": 0},
        "tls_handshake_ms": {"type": "integer", "minimum": 0},
        "ttfb_ms": {"type": "integer", "minimum": 0},
        "download_ms": {"type": "integer", "minimum": 0},
        "e2e_ms": {"type": "integer", "minimum": 0},
        "connection_reused": {"type": "boolean"}
      }
    },
    "bytes_in": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
    "bytes_out": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
    "ok": {"type": "boolean"},
    "error_type": {"type": "string", "enum": ["timeout", "connect_error", "tls_error", "dns_error", "protocol_error", "http_error", "mcp_error", "jsonrpc_error", "tool_error", "rate_limited", "resource_exhausted", "internal", "cancelled", "stream_stall", "unknown"]},
    "error_code": {"type": "string", "minLength": 1, "maxLength": 200},
    "error_message": {"type": "string", "minLength": 1, "maxLength": 4000},
    "transport": {"type": "string", "maxLength": 100},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "jsonrpc_error_code": {"type": "integer", "minimum": -32768, "maximum": 32767},
    "argument_size": {"type": "integer", "minimum": 0},
    "result_size": {"type": "integer", "minimum": 0},
    "argument_depth": {"type": "integer", "minimum": 0},
    "parse_error": {"type": "boolean"},
    "execution_error": {"type": "boolean"},
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_streaming"],
      "properties": {
        "is_streaming": {"type": "boolean"},
        "events_count": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "ended_normally": {"type": "boolean"},
        "stalled": {"type": "boolean"},
        "stall_duration_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "stream_connect_ms": {"type": "integer", "minimum": 0},
        "time_to_first_event_ms": {"type": "integer", "minimum": 0},
        "stall_count": {"type": "integer", "minimum": 0},
        "total_stall_seconds": {"type": "number", "minimum": 0},
        "event_gap_min_ms": {"type": "integer", "minimum": 0},
        "event_gap_max_ms": {"type": "integer", "minimum": 0},
        "event_gap_avg_ms": {"type": "number", "minimum": 0},
        "event_gap_p95_ms": {"type": "integer", "minimum": 0}
      }
    },
    "trace_id": {"type": "string", "maxLength": 128},
    "span_id": {"type": "string", "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": ["tools_call", "tools/call"]}}},
      "then": {"required": ["tool_name"], "properties": {"tool_name": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"ok": {"const": false}}},
      "then": {"required": ["error_type", "error_code", "error_message"]}
    }
  ]
}
